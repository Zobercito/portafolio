{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/apply-csp.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "eval": "node scripts/eval-prompt.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.1.9",
    "groq-sdk": "^1.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
