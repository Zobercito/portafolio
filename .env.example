# Copia este archivo a .env y completa los valores.
# .env está ignorado por git.

# Groq — chat y generación de títulos
GROQ_API_KEY=

# Web3Forms — fallback del formulario (envía la browser; expone la access key).
# Si configuras Resend abajo, este fallback ya no se usa.
WEB3FORMS_ACCESS_KEY=

# Resend — envío del formulario desde el servidor (recomendado).
# Requiere dominio verificado en Resend. Las tres deben estar juntas.
RESEND_API_KEY=
RESEND_FROM=contacto@tudominio.dev
CONTACT_TO_EMAIL=tu-correo@tudominio.dev

# Cloudflare Turnstile — captcha del formulario
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
