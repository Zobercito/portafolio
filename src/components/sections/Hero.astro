---
import NameTypewriter from "../NameTypewriter";
import GithubPreviewButton from "../GithubPreviewButton.astro";
import SocialButton from "../SocialButton.astro";
import type { SocialLink } from "../../types/portfolio";
import { icons } from "../../data/icons";

interface Props {
  firstName: string;
  lastName: string;
  role: string;
  tagline: string;
  socialLinks: SocialLink[];
}

const { firstName, lastName, role, tagline, socialLinks } = Astro.props;
---

<section
  id="hero"
  data-section="0"
  class="relative h-svh xl:h-screen w-full flex flex-col justify-center px-6 sm:px-10 md:px-24 xl:px-6 max-w-5xl mx-auto"
>
  <div class="pt-20 sm:pt-24 pb-10 sm:pb-16">
    <NameTypewriter
      client:idle
      firstName={firstName}
      lastName={lastName}
      speed={80}
    />

    <span
      class="block text-zinc-400 font-medium text-sm sm:text-base tracking-widest uppercase mb-4 sm:mb-5 ml-1 sm:ml-2 animate-fade-up delay-3"
    >
      {role}
    </span>

    <p
      class="text-zinc-300 text-base sm:text-lg max-w-sm md:max-w-md mb-8 sm:mb-10 leading-relaxed animate-fade-up delay-3 ml-1 sm:ml-2"
    >
      {tagline}
    </p>

    <div class="mb-8 flex flex-wrap items-center gap-3 animate-fade-up delay-4">
      <a
        href="#experience"
        class="inline-flex items-center gap-2 rounded-full bg-zinc-100 px-5 py-2.5 text-sm font-medium text-zinc-950 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-300 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
      >
        Explorar mi experiencia
        <span aria-hidden="true">↓</span>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center rounded-full border border-zinc-700 px-5 py-2.5 text-sm font-medium text-zinc-300 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-500 hover:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
      >
        Hablemos
      </a>
    </div>

    <div class="flex flex-wrap gap-3 animate-fade-up delay-4" aria-label="Enlaces sociales y CV">
      {
        socialLinks
          .filter((link) => link.label !== "email")
          .map((link) => {
            if (link.label === "github") {
              return (
                <GithubPreviewButton
                  href={link.href}
                  label={link.label}
                  icon={link.icon}
                  iconHover={link.iconHover}
                />
              );
            }
            if (link.label === "linkedin") {
              return (
                <>
                  <SocialButton
                    href={link.href}
                    label={link.label}
                    icon={link.icon}
                    iconHover={link.iconHover}
                    download={link.download}
                  />
                  <button
                    data-copy-email
                    class="group inline-flex items-center justify-center gap-2 border border-zinc-800
                           text-zinc-400 text-sm px-4 py-2 rounded-full
                           hover:border-zinc-600 hover:text-zinc-100 hover:scale-105 hover:-translate-y-0.5
                           transition-all duration-300"
                  >
                    <div class="relative w-5 h-5 shrink-0 flex items-center justify-center">
                      <span set:html={icons.email.outline} class="absolute inset-0 transition-opacity duration-300 group-hover:opacity-0 flex items-center justify-center" />
                      <span set:html={icons.email.filled} class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center" />
                    </div>
                    <span data-copy-label class="leading-none">Copiar correo</span>
                  </button>
                </>
              );
            }
            return (
              <SocialButton
                href={link.href}
                label={link.label}
                icon={link.icon}
                iconHover={link.iconHover}
                download={link.download}
              />
            );
          })
      }
    </div>

  </div>
</section>
